{
  "name": "sketchframe",
  "description": "Export a Sketch frame as a .sketchframe package: a PNG preview plus a full JSON design tree for AI agents",
  "version": "0.5.0",
  "engines": {
    "sketch": ">=2025.2"
  },
  "skpm": {
    "name": "sketchframe",
    "manifest": "src/manifest.json",
    "main": "sketchframe.sketchplugin"
  },
  "scripts": {
    "build": "skpm-build",
    "watch": "skpm-build --watch",
    "start": "skpm-build --watch --run",
    "postinstall": "npm run build && skpm-link"
  },
  "devDependencies": {
    "@skpm/builder": "^1.0.0"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.13",
    "@skpm/fs": "^0.2.6",
    "fflate": "^0.8.3"
  },
  "author": "Isaac Shea <isaac_shea@icloud.com>",
  "license": "MIT"
}
